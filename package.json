{
  "name": "weredi-glazen-huis",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/cms"
  ],
  "engines": {
    "node": ">=22 <=26"
  },
  "scripts": {
    "dev": "concurrently -k -n CMS,WEB \"npm run develop -w @weredi/cms\" \"npm run dev -w @weredi/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup": "node scripts/setup.mjs",
    "test:integration": "node scripts/integration.mjs",
    "db:check": "npm run db:check -w @weredi/cms"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "@types/node": "^22.18.6"
  },
  "overrides": {
    "zod@>=4 <4.6.6": "4.6.7",
    "@hono/node-server": "^1.19.18"
  }
}
