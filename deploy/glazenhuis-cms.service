[Unit]
Description=Were Di Glazen Huis cms
After=network.target mariadb.service

[Service]
Type=simple
User=glazenhuis
Group=glazenhuis
WorkingDirectory=/var/lib/glazenhuis/current/apps/cms
Environment=NODE_ENV=production
EnvironmentFile=/var/lib/glazenhuis/shared/cms.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/glazenhuis/shared /var/lib/glazenhuis/releases

[Install]
WantedBy=multi-user.target
